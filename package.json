{
    "name": "webview-sdk",
    "private": true,
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "create-event": "node packages/core/src/event.js",
        "doc": "node build-doc.js",
        "build": "npm run build --workspace packages/core",
        "pack": "npm run create-event && npm run build && node scripts/copy-core-lib.js",
        "build-all": "node build-all.js"
    },
    "devDependencies": {
        "typescript": "^5.9.3"
    }
}
        }
      ],
      "explicitlyNotDeprecated": [
        {
          "symbol": "HostAppEventType",
          "platforms": ["android"],
          "declaredIn": { "android": "vn/viettelpay/miniappsdk/common/core/Type.kt" },
          "reason": "Đi SDK → TRANG MINI-APP, không đi tới app chủ. MiniAppVisibility không thay thế nó; đánh dấu phế thải ở đây là trỏ người đọc sang một API làm việc khác."
        },
        {
          "symbol": "VDOHostAppEventType",
          "platforms": ["ios"],
          "declaredIn": { "ios": "Common/Core/Type.swift" },
          "reason": "Như trên. Chỉ có 3 case và không tên nào trùng bản Android — đó là một lệch riêng, không thuộc trục này."
        }
      ],
      "notes": [
        "Sáu danh mục cũ Ở LẠI, KHÔNG gỡ tên nào — bản Android đang công khai nên gỡ là phá tương thích. Sau đợt này có BẢY danh mục cùng mô tả một khái niệm; cái giá đó đã được nhận tường minh.",
        "Phế thải ở đây là CẢNH BÁO LÚC BIÊN DỊCH, không phải gỡ. Hành vi không đổi."
      ]
    }
  ],

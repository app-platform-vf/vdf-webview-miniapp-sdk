{
  "version": "1.0.0",
  "sender": "MINIAPP_WEBVIEW",
  "events": [
    {
      "event": "APP_OPEN_WEBVIEW",
      "description": "Mở một WebView mới với URL và cấu hình tùy chỉnh.",
      "request": {
        "data": {
          "meta_data": "object",
          "required": true,
          "description": "Du lieu",
          "fields": {
            "url": {
              "type": "string",
              "required": true,
              "description": "URL của webview cần mở"
            },
            "serviceName": {
              "type": "string",
              "required": false,
              "description": "Tiêu đề hiển thị trên app bar"
            },
            "isPaymentConfirm": {
              "type": "boolean",
              "required": false,
              "description": "false = đóng mini app để sang gateway thanh toán"
            },
            "resourceType": {
              "type": "string",
              "required": false,
              "description": "\"HTML\" = mở trong webview, khác = mở browser mặc định"
            },
            "returnUrl": {
              "type": "string",
              "required": false,
              "description": "URL trả về khi thành công/thất bại/timeout"
            },
            "cancelUrl": {
              "type": "string",
              "required": false,
              "description": "URL trả về khi người dùng cancel"
            }
          }
        }
      },
      "response": {
        "data": {
          "meta_data": "object",
          "required": true,
          "description": "Ket qua",
          "fields": {
            "url": {
              "type": "string",
              "required": false,
              "description": "url"
            },
            "type": {
              "type": "string",
              "required": false,
              "description": "RETURN - Người dùng hoàn tất và quay lại, kèm theo URL; CANCEL - Người dùng hủy, kèm theo URL; CLOSED - Người dùng tự đóng webview, không có URL"
            }
          }
        }
      }
    },
    {
      "event": "APP_OPEN_STORE",
      "description": "Mở ứng dụng từ App Store/Google Play hoặc launch app đã cài.",
      "request": {
        "data": {
          "meta_data": "object",
          "required": true,
          "description": "Du lieu",
          "fields": {
            "fallbackUrlAndroid": {
              "type": "string",
              "required": false,
              "description": "URL android"
            },
            "fallbackUrlIos": {
              "type": "string",
              "required": false,
              "description": "URL Ios"
            }
          }
        }
      },
      "response": {}
    },
    {
      "event": "EXIT",
      "description": "Đóng Mini App và điều hướng về màn hình khác.",
      "request": {
        "data": {
          "meta_data": "object",
          "required": true,
          "description": "Du lieu",
          "fields": {
            "navigationAction": {
              "type": "string",
              "required": false,
              "description": "RETURN_HOME_APP - Quay về trang chủ của host app; TH khác - Chỉ đóng Mini App"
            }
          }
        }
      },
      "response": {}
    },
    {
      "event": "OPEN_EXTERNAL_LINK",
      "description": "Mở URL bằng browser mặc định của hệ thống.",
      "request": {
        "data": {
          "meta_data": "object",
          "required": true,
          "description": "Du lieu",
          "fields": {

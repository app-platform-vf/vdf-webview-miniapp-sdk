{
  "version": "1.0.0",
  "sender": "MINIAPP_WEBVIEW",
  "parityAxes": [
    {
      "axis": "MiniAppVisibility",
      "direction": "sdk-to-host",
      "reachableFromPage": false,
      "description": "Trạng thái hiển thị của bề mặt mini-app, đi từ SDK native lên APP CHỦ. Năm giá trị, cùng tên cùng nghĩa trên Android và iOS. ⚠️ KHÔNG phải event: trang mini-app không gọi được và không nghe được trục này — nó không có mặt trong `events.json.events`, không sinh ra hàm API nào, và không có kênh nào chuyển nó xuống trang. Khai ở đây để hợp đồng nói ra được rằng trục này tồn tại và để máy đối chiếu hai danh mục native.",
      "values": [
        {
          "value": "FIRST_VISIBLE",
          "description": "Bề mặt mini-app hiện ra LẦN ĐẦU. Đúng một lần cho mỗi bề mặt, kể cả khi app chủ gắn bộ lắng nghe muộn."
        },
        {
          "value": "VISIBLE_AGAIN",
          "description": "Hiện lại sau khi đã bị che hoặc đã xuống nền. KHÔNG BAO GIỜ dùng thay cho lần đầu."
        },
        {
          "value": "COVERED",
          "description": "Bị một bề mặt khác trong cùng ứng dụng che đi."
        },
        {
          "value": "BACKGROUNDED",
          "description": "Cả ứng dụng xuống nền."
        },
        {
          "value": "CLOSED",
          "description": "Bề mặt mini-app đóng hẳn. Chỉ tới được qua nhịp đẩy — nhịp hỏi không bao giờ trả giá trị này."
        }
      ],
      "semanticsCaveats": [
        "Hai giá trị VISIBLE_* mang NGHĨA YẾU: 'không thấy bằng chứng bị che', không phải 'chắc chắn không bị che'. Overlay của app chủ và cửa sổ của hệ điều hành không nền tảng nào báo được.",
        "Android: app chủ add() một Fragment đè lên mà không hide() cái cũ thì KHÔNG tín hiệu nào phát. Đây là giới hạn đã đăng ký của nền tảng, không phải việc còn nợ.",
        "Đối xứng về GIÁ TRỊ và HÀNH VI, không đối xứng về hình dạng lời gọi: tên hàm và cách gắn bộ lắng nghe theo thói quen của từng nền tảng.",
        "BACKGROUNDED KHÔNG đối xứng về THỜI ĐIỂM. iOS phát ngay trong handler didEnterBackground, đồng bộ. Android đi qua ProcessLifecycleOwner của AndroidX, thứ trì hoãn ON_STOP khoảng 700 ms bằng một lần đặt hẹn — đó là cách nó phân biệt 'đổi Activity' với 'thật sự xuống nền'. Chênh lệch này đã được cân nhắc và CHẤP NHẬN ngày 2026-09-24: bỏ độ trễ đi thì mỗi lần xoay màn sinh ra một lần xuống nền giả, và giá đó đắt hơn. App chủ KHÔNG được coi BACKGROUNDED là mốc thời gian chính xác trên Android; thứ đối xứng là THỨ TỰ và GIÁ TRỊ, không phải độ trễ.",
        "Hệ quả của điều trên: trên Android, tín hiệu BACKGROUNDED rời SDK khi ngăn xếp đã về vòng lặp thông điệp, KHÔNG còn trong thân callback vòng đời. Phép kiểm tĩnh của AC1 quét mã nguồn SDK nên nó KHÔNG nhìn thấy điều này — lần đặt hẹn nằm trong thư viện AndroidX, không nằm trong mã SDK. Đây là chỗ phép kiểm đó xanh vì cấu tạo, không phải vì đã đo."
      ],
      "deprecates": [
        {
          "symbol": "currentState()",
          "kind": "function",
          "platforms": ["android", "ios"],
          "declaredIn": {
            "android": "vn/viettelpay/miniappsdk/runtime/MiniAppDisplay.kt",
            "ios": "Runtime/Display/MiniAppDisplay.swift"
          },
          "replacement": "currentVisibility()"
        },
        {
          "symbol": "observeLifecycle(...)",
          "kind": "function",
          "platforms": ["android", "ios"],
          "declaredIn": {
            "android": "vn/viettelpay/miniappsdk/runtime/bridge/HostAppBridge.kt",
            "ios": "Runtime/Bridge/VDOHostAppBridge.swift"
          },
          "replacement": null,
          "note": "KHÔNG trỏ trống sang observeVisibility. Hai tín hiệu 'đang khởi tạo' và 'lỗi kèm thông điệp' không có chỗ trên trục năm giá trị, nên cần chúng thì tiếp tục gọi hàm này — nó chạy y nguyên, không có kế hoạch gỡ."
        },
        {
          "symbol": "MiniAppDisplayState",
          "kind": "type",
          "platforms": ["android"],
          "declaredIn": { "android": "vn/viettelpay/miniappsdk/runtime/MiniAppDisplay.kt" },
          "replacement": "MiniAppVisibility"
        },
        {
          "symbol": "MiniAppDisplayState",
          "kind": "type",
          "platforms": ["ios"],
          "declaredIn": { "ios": "Runtime/Display/MiniAppDisplay.swift" },
          "replacement": "MiniAppVisibility"
        },
        {
          "symbol": "MiniAppLifecycle",

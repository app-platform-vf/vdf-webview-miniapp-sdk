{
  "version": "1.0.0",
  "sender": "MINIAPP_WEBVIEW",
  "events": [
    {
      "event": "GET_USER_INFO",
      "description": "Lay thong tin nguoi dung",
      "request": {
        "data": {
          "meta_data": "object",
          "required": false,
          "description": "Thong tin request",
          "fields": {
            "user_id": { "type": "string", "required": false, "description": "ID nguoi dung (bo trong de lay user hien tai)" }
          }
        }
      },
      "response": {
        "data": {
          "meta_data": "object",
          "description": "Thong tin nguoi dung",
          "fields": {
            "user_id": { "type": "string", "description": "ID nguoi dung" },
            "full_name": { "type": "string", "description": "Ho va ten" },
            "phone": { "type": "string", "description": "So dien thoai" },
            "email": { "type": "string", "description": "Email" },
            "avatar": { "type": "string", "description": "URL anh dai dien" }
          }
        }
      }
    },
    {
      "event": "GET_LOCATION",
      "description": "Lay vi tri hien tai",
      "request": {
        "data": {
          "meta_data": "object",
          "required": false,
          "description": "Tuy chon vi tri",
          "fields": {
            "type": { "type": "string", "required": false, "description": "Loai toa do: wgs84 | gcj02", "default": "wgs84" },
            "high_accuracy": { "type": "boolean", "required": false, "description": "Bat do chinh xac cao", "default": false }
          }
        }
      },
      "response": {
        "data": {
          "meta_data": "object",
          "description": "Toa do vi tri",
          "fields": {
            "latitude": { "type": "number", "description": "Vi do" },
            "longitude": { "type": "number", "description": "Kinh do" },
            "accuracy": { "type": "number", "description": "Do chinh xac (met)" },
            "speed": { "type": "number", "description": "Toc do (m/s)" }
          }
        }
      }
    },
    {
      "event": "SCAN_QR_CODE",
      "description": "Mo camera quet ma QR",
      "request": {
        "data": {
          "meta_data": "object",
          "required": false,
          "description": "Tuy chon quet",
          "fields": {
            "scan_type": { "type": "string", "required": false, "description": "Loai ma: qr | barcode | all", "default": "qr" }
          }
        }
      },
      "response": {
        "data": {
          "meta_data": "object",
          "description": "Ket qua quet",
          "fields": {
            "code": { "type": "string", "description": "Noi dung ma da quet" },
            "format": { "type": "string", "description": "Dinh dang ma: QR_CODE | EAN_13 | ..." }
          }
        }
      }
    },
    {
      "event": "GET_SYSTEM_INFO",
      "description": "Lay thong tin thiet bi va he dieu hanh",
      "request": {},
      "response": {
        "data": {
          "meta_data": "object",
          "description": "Thong tin thiet bi",
          "fields": {
            "platform": { "type": "string", "description": "android | ios" },
            "os_version": { "type": "string", "description": "Phien ban OS" },
            "brand": { "type": "string", "description": "Hang san xuat" },
            "model": { "type": "string", "description": "Ten thiet bi" },
            "sdk_version": { "type": "string", "description": "Phien ban SDK native" },
            "screen_width": { "type": "number", "description": "Chieu rong man hinh (px)" },
            "screen_height": { "type": "number", "description": "Chieu cao man hinh (px)" }
          }
        }
      }
    },
    {
      "event": "SET_STORAGE",
      "description": "Luu du lieu vao storage native",
      "request": {
        "data": {
          "meta_data": "stringify",
          "required": true,
          "description": "Du lieu luu tru (se duoc stringify)",
          "fields": {
            "key": { "type": "string", "required": true, "description": "Key luu tru" },
            "value": { "type": "any", "required": true, "description": "Gia tri can luu" }
          }
        }
      },
      "response": {
        "data": {
          "meta_data": "object",
          "description": "Ket qua",
          "fields": {
            "success": { "type": "boolean", "description": "Ket qua luu tru" }
          }
        }
      }
    },
    {
      "event": "GET_STORAGE",
      "description": "Doc du lieu tu storage native",
      "request": {
        "data": {
          "meta_data": "object",
          "required": true,
          "description": "Thong tin key",
          "fields": {
            "key": { "type": "string", "required": true, "description": "Key can doc" }
          }
        }
      },
      "response": {
        "data": {
          "meta_data": "object",
          "description": "Du lieu doc duoc",
          "fields": {
            "key": { "type": "string", "description": "Key da doc" },
            "value": { "type": "any", "description": "Gia tri" }
          }
        }
      }
    },
    {
      "event": "REMOVE_STORAGE",
      "description": "Xoa du lieu theo key trong storage",
      "request": {
        "data": {
          "meta_data": "object",
          "required": true,
          "description": "Thong tin key",
          "fields": {
            "key": { "type": "string", "required": true, "description": "Key can xoa" }
          }
        }
      },
      "response": {
        "data": {
          "meta_data": "object",
          "description": "Ket qua",
          "fields": {
            "success": { "type": "boolean", "description": "Ket qua xoa" }
          }
        }
      }
    },
    {
      "event": "SHOW_TOAST",
      "description": "Hien thi thong bao toast",
      "request": {
        "data": {
          "meta_data": "object",
          "required": true,
          "description": "Noi dung toast",
          "fields": {
            "title": { "type": "string", "required": true, "description": "Noi dung hien thi" },
            "icon": { "type": "string", "required": false, "description": "Icon: success | error | loading | none", "default": "none" },
            "duration": { "type": "number", "required": false, "description": "Thoi gian hien thi (ms)", "default": 2000 }
          }
        }
      },
      "response": {}
    },
    {
      "event": "SHOW_LOADING",
      "description": "Hien thi loading",
      "request": {
        "data": {
          "meta_data": "object",
          "required": false,
          "description": "Tuy chon loading",
          "fields": {
            "title": { "type": "string", "required": false, "description": "Noi dung loading", "default": "" },
            "mask": { "type": "boolean", "required": false, "description": "Hien thi lop phu", "default": false }
          }
        }
      },
      "response": {}
    },
    {
      "event": "HIDE_LOADING",
      "description": "An loading",
      "request": {},
      "response": {}
    },
    {
      "event": "SHOW_DIALOG",
      "description": "Hien thi hop thoai xac nhan",
      "request": {
        "data": {
          "meta_data": "object",
          "required": true,
          "description": "Noi dung dialog",
          "fields": {
            "title": { "type": "string", "required": false, "description": "Tieu de" },
            "content": { "type": "string", "required": true, "description": "Noi dung" },
            "confirm_text": { "type": "string", "required": false, "description": "Text nut xac nhan", "default": "OK" },
            "cancel_text": { "type": "string", "required": false, "description": "Text nut huy", "default": "Huy" },
            "show_cancel": { "type": "boolean", "required": false, "description": "Hien nut huy", "default": true }
          }
        }
      },
      "response": {
        "data": {
          "meta_data": "object",
          "description": "Ket qua chon",
          "fields": {
            "confirm": { "type": "boolean", "description": "Nguoi dung nhan xac nhan" },
            "cancel": { "type": "boolean", "description": "Nguoi dung nhan huy" }
          }
        }
      }
    },
    {
      "event": "NAVIGATE_TO",
      "description": "Chuyen trang (them vao stack)",
      "request": {
        "data": {
          "meta_data": "object",
          "required": true,
          "description": "Thong tin dieu huong",
          "fields": {
            "url": { "type": "string", "required": true, "description": "Duong dan trang" },
            "params": { "type": "object", "required": false, "description": "Tham so truyen theo" }
          }
        }
      },
      "response": {
        "data": {
          "meta_data": "object",
          "description": "Ket qua",
          "fields": {
            "success": { "type": "boolean", "description": "Ket qua dieu huong" }
          }
        }
      }
    },
    {
      "event": "NAVIGATE_BACK",
      "description": "Quay lai trang truoc",
      "request": {
        "data": {
          "meta_data": "object",
          "required": false,
          "description": "Tuy chon",
          "fields": {
            "delta": { "type": "number", "required": false, "description": "So trang quay lai", "default": 1 }
          }
        }
      },
      "response": {
        "data": {
          "meta_data": "object",
          "description": "Ket qua",
          "fields": {
            "success": { "type": "boolean", "description": "Ket qua" }
          }
        }
      }
    },
    {
      "event": "GET_ACCESS_TOKEN",
      "description": "Lay access token cua nguoi dung",
      "request": {},
      "response": {
        "data": {
          "meta_data": "object",
          "description": "Token info",
          "fields": {
            "access_token": { "type": "string", "description": "Access token" },
            "expires_in": { "type": "number", "description": "Thoi gian het han (giay)" }
          }
        }
      }
    },
    {
      "event": "OPEN_DEEP_LINK",
      "description": "Mo deep link trong app native",
      "request": {
        "data": {
          "meta_data": "object",
          "required": true,
          "description": "Thong tin deep link",
          "fields": {
            "url": { "type": "string", "required": true, "description": "Deep link URL" },
            "fallback_url": { "type": "string", "required": false, "description": "URL du phong neu khong mo duoc" }
          }
        }
      },
      "response": {
        "data": {
          "meta_data": "object",
          "description": "Ket qua",
          "fields": {
            "success": { "type": "boolean", "description": "Mo thanh cong hay khong" }
          }
        }
      }
    },
    {
      "event": "SHARE",
      "description": "Chia se noi dung",
      "request": {
        "data": {
          "meta_data": "object",
          "required": true,
          "description": "Noi dung chia se",
          "fields": {
            "title": { "type": "string", "required": true, "description": "Tieu de chia se" },
            "description": { "type": "string", "required": false, "description": "Mo ta" },
            "image_url": { "type": "string", "required": false, "description": "URL anh" },
            "link": { "type": "string", "required": false, "description": "Link chia se" }
          }
        }
      },
      "response": {
        "data": {
          "meta_data": "object",
          "description": "Ket qua chia se",
          "fields": {
            "success": { "type": "boolean", "description": "Chia se thanh cong" },
            "channel": { "type": "string", "description": "Kenh chia se: facebook | zalo | copy | ..." }
          }
        }
      }
    },
    {
      "event": "CLOSE_MINIAPP",
      "description": "Dong miniapp va quay ve app native",
      "request": {},
      "response": {}
    }
  ]
}

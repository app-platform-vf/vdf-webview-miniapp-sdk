{
  "version": "1.0.0",
  "sender": "MINIAPP_WEBVIEW",
  "events": [
    {
      "event": "APP_OPEN_WEBVIEW",
      "description": "Mở một WebView mới với URL và cấu hình tùy chỉnh.",
      "request": {
        "data": {
          "meta_data": "object",
          "required": true,
          "description": "Du lieu",
          "fields": {
            "url": {
              "type": "string",
              "required": true,
              "description": "URL của webview cần mở",
              "default": "https://example.com"
            },
            "serviceName": {
              "type": "string",
              "required": false,
              "description": "Tiêu đề hiển thị trên app bar",
              "default": "Tên dịch vụ"
            },
            "isPaymentConfirm": {
              "type": "boolean",
              "required": false,
              "description": "false = đóng mini app để sang gateway thanh toán",
              "default": false
            },
            "resourceType": {
              "type": "string",
              "required": false,
              "description": "HTML = mở trong webview, khác = mở browser mặc định",
              "default": "HTML"
            },
            "returnUrl": {
              "type": "string",
              "required": false,
              "description": "URL trả về khi thành công/thất bại/timeout",
              "default": "https://example.com/return"
            },
            "cancelUrl": {
              "type": "string",
              "required": false,
              "description": "URL trả về khi người dùng cancel",
              "default": "https://example.com/cancel"
            }
          }
        }
      },
      "response": {
        "data": {
          "meta_data": "object",
          "required": true,
          "description": "Ket qua",
          "fields": {
            "url": {
              "type": "string",
              "required": false,
              "description": "url",
              "default": "https://example.com/return?status=success"
            },
            "type": {
              "type": "string",
              "required": false,
              "description": "RETURN - Người dùng hoàn tất và quay lại, kèm theo URL; CANCEL - Người dùng hủy, kèm theo URL; CLOSED - Người dùng tự đóng webview, không có URL",
              "default": "RETURN"
            }
          }
        }
      }
    },
    {
      "event": "APP_OPEN_STORE",
      "description": "Mở ứng dụng từ App Store/Google Play hoặc launch app đã cài.",
      "request": {
        "data": {
          "meta_data": "object",
          "required": true,
          "description": "Du lieu",
          "fields": {
            "fallbackUrlAndroid": {
              "type": "string",
              "required": false,
              "description": "URL android",
              "default": "market://details?id=com.example.app"
            },
            "fallbackUrlIos": {
              "type": "string",
              "required": false,
              "description": "URL Ios",
              "default": "itms-apps://itunes.apple.com/app/id123456789"
            }
          }
        }
      },
      "response": {}
    },
    {
      "event": "EXIT",
      "description": "Đóng Mini App và điều hướng về màn hình khác.",
      "request": {
        "data": {
          "meta_data": "object",
          "required": true,
          "description": "Du lieu",
          "fields": {
            "navigationAction": {
              "type": "string",
              "required": false,
              "description": "RETURN_HOME_APP - về trang chủ của host app; TH khác - Chỉ đóng Mini App"
            }
          }
        }
      },
      "response": {}
    },
    {
      "event": "OPEN_EXTERNAL_LINK",
      "description": "Mở URL bằng browser mặc định của hệ thống.",
      "request": {
        "data": {
          "meta_data": "object",
          "required": true,
          "description": "Du lieu",
          "fields": {
            "uri": {
              "type": "string",
              "required": false,
              "description": "Link Ngoài",
              "default": "https://google.com"
            }
          }
        }
      },
      "response": {}
    },
    {
      "event": "OPEN_MINI_APP",
      "description": "Mở một Mini App khác từ Mini App hiện tại.",
      "request": {
        "data": {
          "meta_data": "object",
          "required": true,
          "description": "Du lieu",
          "fields": {
            "route": {
              "type": "object",
              "required": false,
              "description": "Định tuyến màn hình trong Mini App ",
              "default": "{       \"screenName\": \"home\"     }"
            },
            "miniappKey": {
              "type": "string",
              "required": false,
              "description": "Key của Mini App cần mở ",
              "default": "01K5FY191HP42SMMJXHWG545ZZ"
            },
            "additional": {
              "type": "object",
              "required": false,
              "description": "Dữ liệu bổ sung truyền cho Mini App ",
              "default": "{       \"param1\": \"value1\",       \"param2\": \"value2\"     }"
            },
            "launchConfig": {
              "type": "object",
              "required": false,
              "description": "Chế độ launchConfig.mode: present(Mở Mini App mới đè lên Mini App cũ) hoặc replace(Kill Mini App cũ trước khi mở Mini App mới)\t;  ",
              "default": "{       \"mode\": \"present\"     }"
            },
            "themeConfig": {
              "type": "object",
              "required": false,
              "description": "Style cho navigation bar",
              "default": "{       \"title\": \"My App\",       \"headerColor\": \"#EE0033\",       \"headerTitle\": \"Videos\",       \"textColor\": \"white\",       \"leftButton\": \"back\",       \"actionButtonThemeType\": \"normal\",       \"hideAndroidBottomNavigationBar\": true,       \"hideIOSSafeAreaBottom\": true     }"
            },
            "tracking": {
              "type": "object",
              "required": false,
              "description": "Thông tin tracking",
              "default": "{       \"campaign\": \"promotion\",       \"utmSource\": \"miniapp\"     }"
            }
          }
        }
      },
      "response": {}
    },
    {
      "event": "REQUEST_MULTIPLE_USER_DATA_PERMISSION",
      "description": "Yêu cầu nhiều quyền user data cùng một lúc.",
      "request": {
        "data": {
          "meta_data": "stringify",
          "required": true,
          "description": "Du lieu",
          "fields": {
            "permissionCodes": {
              "type": "array",
              "items": "string",
              "description": "Danh sách mã quyền",
              "default": "[\"USER_AGE_PERMISSION\",\"USER_NAME_PERMISSION\",\"USER_FULL_NAME_PERMISSION\",\"USER_PHONE_NUMBER_PERMISSION\",\"USER_AVATAR_PERMISSION\",\"USER_BIRTH_DATE_PERMISSION\",\"USER_GENDER_PERMISSION\",\"USER_NATIONAL_ID_PERMISSION\"]"
            },
            "useSameReason": {
              "type": "boolean",
              "required": false,
              "description": "Các quyền dùng chung 1 mã lý do",
              "default": true
            }
          }
        }
      },
      "response": {
        "data": {
          "meta_data": "array",
          "required": false,
          "description": "Du lieu",
          "items": "object",
          "fields": {
            "permissionCode": {
              "type": "string",
              "required": false,
              "description": "Mã quyền",
              "default": "USER_AGE_PERMISSION"
            },
            "result": {
              "type": "string",
              "required": false,
              "description": "Granted - Quyền đã được cấp;  Denied -  Quyền bị từ chối; NotFound -  Permission code không tồn tại",
              "default": "Denied"
            },
            "message": {
              "type": "string",
              "required": false,
              "description": "Nội dung ",
              "default": "USER_AGE_PERMISSION is denied"
            }
          }
        }
      }
    },
    {
      "event": "CHECK_MULTIPLE_USER_DATA_PERMISSION",

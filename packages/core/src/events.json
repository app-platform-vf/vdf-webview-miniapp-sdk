              "type": "string",
              "required": false,
              "description": "Link Ngoài"
            }
          }
        }
      },
      "response": {}
    },
    {
      "event": "OPEN_MINI_APP",
      "description": "Mở một Mini App khác từ Mini App hiện tại.",
      "request": {
        "data": {
          "meta_data": "object",
          "required": true,
          "description": "Du lieu",
          "fields": {
            "route": {
              "type": "object",
              "required": false,
              "description": "Định tuyến màn hình trong Mini App - \"route\": {       \"screenName\": \"home\"     }"
            },
            "miniappKey": {
              "type": "string",
              "required": false,
              "description": "Key của Mini App cần mở - "
            },
            "additional": {
              "type": "object",
              "required": false,
              "description": "Dữ liệu bổ sung truyền cho Mini App - \"additional\": {       \"param1\": \"value1\",       \"param2\": \"value2\"     }"
            },
            "launchConfig": {
              "type": "object",
              "required": false,
              "description": "Chế độ launchConfig.mode: present(Mở Mini App mới đè lên Mini App cũ) hoặc replace(Kill Mini App cũ trước khi mở Mini App mới)\t;  "
            },
            "navStyle": {
              "type": "object",
              "required": false,
              "description": "Style cho navigation bar - {       \"color\": \"#FF0000\",       \"hidden\": \"false\"     }"
            },
            "tracking": {
              "type": "object",
              "required": false,
              "description": "Thông tin tracking - {       \"campaign\": \"promotion\",       \"utmSource\": \"miniapp\"     }"
            }
          }
        }
      },
      "response": {}
    },
    {
